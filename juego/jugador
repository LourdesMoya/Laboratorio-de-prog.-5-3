class Mover {

  PVector location;
  PVector velocity;
  PVector acceleration;

  float topspeed;

  String direccion_jugador;


  Mover() {

    location = new PVector(
      width/2,
      height - 50
      );

    velocity = new PVector(0, 0);

    acceleration = new PVector(0, 0);

    topspeed = 5;

    direccion_jugador = "derecha";
  }


  void update() {

    acceleration = new PVector(0, 0);


    // MOVIMIENTO
    if (keyPressed) {

      if (keyCode == UP) {

        acceleration.y = -0.2;
        direccion_jugador = "arriba";

      } else if (keyCode == DOWN) {

        acceleration.y = 0.2;
        direccion_jugador = "abajo";

      } else if (keyCode == LEFT) {

        acceleration.x = -0.2;
        direccion_jugador = "izquierda";

      } else if (keyCode == RIGHT) {

        acceleration.x = 0.2;
        direccion_jugador = "derecha";
      }
    }


    velocity.add(acceleration);

    velocity.limit(topspeed);


    PVector nuevaPosicion =
      PVector.add(location, velocity);


    // COLISIÓN CON HIELO
    for (Hielo h : hielos) {

      if (h.chocaConJugador(nuevaPosicion)) {

        float distanciaAhora =
          PVector.dist(location, h.location);

        float distanciaDespues =
          PVector.dist(nuevaPosicion, h.location);


        if (distanciaDespues < distanciaAhora) {

          velocity.mult(0);

          return;
        }
      }
    }


    location = nuevaPosicion;


    // BORDES
    if (location.x < 24) {

      location.x = 24;
      velocity.x = 0;
    }

    if (location.x > width - 24) {

      location.x = width - 24;
      velocity.x = 0;
    }

    if (location.y < 24) {

      location.y = 24;
      velocity.y = 0;
    }

    if (location.y > height - 24) {

      location.y = height - 24;
      velocity.y = 0;
    }
  }


  void display() {

    stroke(255);
    strokeWeight(2);

    fill(127);

    ellipse(
      location.x,
      location.y,
      48,
      48
      );
  }
}
