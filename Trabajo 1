int xprev=0;
int yprev=0;

void setup(){
  size(800,600);
}
void draw(){

if (mousePressed==true){
  line (mouseX, mouseY, xprev , yprev);
  line ( width-mouseX, mouseY, width-xprev , yprev);
  line (mouseX, height-mouseY, xprev , height-yprev);
  line ( width-mouseX, height-mouseY, width-xprev , height-yprev);
}
xprev=mouseX;
yprev=mouseY;
}
