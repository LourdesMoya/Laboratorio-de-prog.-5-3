class Fuego {

  PVector location;
  PVector velocity;


  Fuego(
    float x,
    float y,
    PVector objetivo) {

    location =
      new PVector(x, y);


    velocity =
      PVector.sub(
      objetivo,
      location
      );


    if (velocity.mag() > 0) {

      velocity.normalize();

      velocity.mult(7);
    }
  }


  void update() {

    location.add(velocity);
  }


  void display() {

    // Aura
    noStroke();

    fill(255, 255, 0, 120);

    ellipse(
      location.x,
      location.y,
      28,
      28
      );


    // Fuego
    fill(255, 120, 0);

    stroke(255, 0, 0);

    strokeWeight(2);

    ellipse(
      location.x,
      location.y,
      16,
      16
      );


    // Centro
    fill(255, 255, 150);

    noStroke();

    ellipse(
      location.x - 2,
      location.y - 2,
      6,
      6
      );
  }


  boolean fueraDePantalla() {

    return
      location.x < 0 ||
      location.x > width ||
      location.y < 0 ||
      location.y > height;
  }
}

