class Hielo {

  PVector location;

  float ancho;
  float alto;

  boolean derritiendo;

  int tiempoFuego;

  boolean esFijo;


  // Constructor de los hielos
  Hielo(float x, float y, boolean fijo) {

    location = new PVector(x, y);

    ancho = 35;
    alto = 35;

    derritiendo = false;

    tiempoFuego = 0;

    esFijo = fijo;
  }


  void update() {
    // El hielo no se mueve.
  }


  void display() {

    rectMode(CENTER);


    // HIELO DERRITIÉNDOSE
    if (derritiendo) {

      float escala =
        map(
        tiempoFuego,
        0,
        90,
        1,
        0.1
        );


      float parpadeo =
        sin(frameCount * 0.5) * 50;


      fill(
        150 + parpadeo,
        150,
        255 - tiempoFuego
        );


      stroke(255, 150, 0);

      strokeWeight(2);


      rect(
        location.x,
        location.y,
        ancho * escala,
        alto * escala
        );


      // Vapor
      noStroke();

      fill(200, 200, 200, 150);


      ellipse(
        location.x + random(-5, 5),
        location.y - 20 - tiempoFuego * 0.2,
        8,
        8
        );


      return;
    }


    // HIELO FIJO DEL MAPA
    if (esFijo) {

      fill(80, 160, 255);

      stroke(0, 40, 130);

      strokeWeight(3);

    } else {

      // HIELO CREADO POR EL JUGADOR
      fill(150, 220, 255);

      stroke(255);

      strokeWeight(2);
    }


    rect(
      location.x,
      location.y,
      ancho,
      alto
      );
  }


  // COLISIÓN CON EL JUGADOR
  boolean chocaConJugador(PVector p) {

    return
      p.x + 24 > location.x - ancho/2 &&
      p.x - 24 < location.x + ancho/2 &&
      p.y + 24 > location.y - alto/2 &&
      p.y - 24 < location.y + alto/2;
  }


  // COLISIÓN CON EL BOT
  boolean chocaConBot(PVector p) {

    return
      p.x + 20 > location.x - ancho/2 &&
      p.x - 20 < location.x + ancho/2 &&
      p.y + 20 > location.y - alto/2 &&
      p.y - 20 < location.y + alto/2;
  }


  // COLISIÓN CON FUEGO
  boolean chocaCon(PVector p) {

    return PVector.dist(
      location,
      p
      ) < 25;
  }


  // ¿ESTE HIELO ESTÁ EN EL CAMINO?
  boolean bloqueaCamino(
    PVector inicio,
    PVector fin) {

    PVector camino =
      PVector.sub(fin, inicio);


    float distanciaTotal =
      camino.mag();


    if (distanciaTotal == 0) {

      return false;
    }


    camino.normalize();


    // Recorremos la línea entre bot y jugador
    for (
      float d = 0;
      d <= distanciaTotal;
      d += 5
      ) {

      PVector punto =
        PVector.add(
        inicio,
        PVector.mult(
        camino,
        d
        )
        );


      if (
        punto.x >
        location.x - ancho/2 - 20 &&

        punto.x <
        location.x + ancho/2 + 20 &&

        punto.y >
        location.y - alto/2 - 20 &&

        punto.y <
        location.y + alto/2 + 20
        ) {

        return true;
      }
    }


    return false;
  }
}

