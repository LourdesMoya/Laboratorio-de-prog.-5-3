int cantfil=15;
int cantcol=9;
boolean [][] fuecliqueado;

void setup(){
  size(900,600);
  fuecliqueado=new boolean [cantfil] [cantcol];
}
void draw(){
    float ancho=width/cantcol;
    float alto=height/cantfil;
    
    for (int i=0; i< cantcol;i++){ 
    for (int j=0; j< cantfil;j++){ 
      
      float x= i* ancho;
      float y= i* ancho;
      
      float limiteDerecho = + ancho;
      float limiteinf = y + alto;
      
      if ((mousePressed) && (x < mouseX) && (mouseX < limiteDerecho)
      && (Y < mouseY) && (mouseY < limiteinf))
      fuecliqueado[i][j]= true;
      
      if ( fuecliqueado [i][j])  fill (0);  else  fill (255);
    
      rect (x,j,ancho,alto);
    }
    }
  }
