int cols= 20;
int fil= 15;
float cW; // Ancho de cada celda
float cH; //  alto de cada celda



float [ ] [ ] DistanciaGrillas;

void setup ( ){
size ( 800, 600);
cW= width / float ( cols );
cH= height / float ( fil );

DistanciaGrillas = new float [ cols ] [ fil ];

noStroke();// sin bordes para los rectángulos


}


void draw ( ) {

background (255 );
 
ActualizarDistancias ( );

DibujarGrillasConDistancia( );
}

void ActualizarDistancias ( ) {

float maxDistPosible = dist ( 0, 0, width, height);

for (int x = 0; x < cols; x ++) {
for (int y = 0; y < fil; y ++) {

float centerX = x * cW + cW / 2;
float centerY = y * cH + cH / 2;

float DistanciaMouse = dist (centerX, centerY, mouseX, mouseY);

DistanciaGrillas [ x ] [ y ] = DistanciaMouse ;
}
}
}

void DibujarGrillasConDistancia ( ) {

float maxDistPosible = dist (0, 0, width, height);
for (int x = 0; x < cols; x ++) {
for (int y = 0; y < fil; y ++) {

float px = x * cW;
float py= y * cH;


float DistanciaActual = DistanciaGrillas [ x ] [ y ] ;

float nivelGis = map (DistanciaActual, 0, maxDistPosible, 255, 0); // map transforma un rango a otro rango de formar proporcional.
fill (nivelGis );
rect ( px, py, cW, cH);
}
}
}
