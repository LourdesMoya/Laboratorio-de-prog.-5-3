Mover mover;
Bot bot;

ArrayList<Hielo> hielos;
ArrayList<Fuego> fuegos;

void setup() {
  size(640, 360);

  mover = new Mover();
  bot = new Bot();

  hielos = new ArrayList<Hielo>();
  fuegos = new ArrayList<Fuego>();
}

void draw() {
  background(0);

  // JUGADOR
  mover.update();
  mover.display();

  // BOT
  bot.update(mover.location);
  bot.display();

  // Actualizar hielos
  for (int i = hielos.size() - 1; i >= 0; i--) {
    Hielo h = hielos.get(i);

    h.update();
    h.display();

    // Si el fuego toca el hielo, se destruyen
    for (int j = fuegos.size() - 1; j >= 0; j--) {
      Fuego f = fuegos.get(j);

      if (h.chocaCon(f.location)) {
        hielos.remove(i);
        fuegos.remove(j);
        break;
      }
    }
  }

  // Actualizar fuego
  for (int i = fuegos.size() - 1; i >= 0; i--) {
    Fuego f = fuegos.get(i);

    f.update();
    f.display();

    // Si el fuego sale de la pantalla
    if (f.fueraDePantalla()) {
      fuegos.remove(i);
    }
  }

  // Comprobar si el bot atrapó al jugador
  if (bot.atrapo(mover.location)) {
    background(150, 0, 0);

    fill(255);
    textAlign(CENTER, CENTER);
    textSize(30);
    text("¡TE ATRAPÓ!", width/2, height/2);
  }
}


// ==========================================
// JUGADOR
// ==========================================

class Mover {

  PVector location;
  PVector velocity;
  PVector acceleration;

  float topspeed;

  Mover() {
    location = new PVector(width/2, height/2);
    velocity = new PVector(0, 0);
    acceleration = new PVector(0, 0);

    topspeed = 5;
  }

  void update() {

    acceleration = new PVector(0, 0);

    // Movimiento con las flechas
    if (keyPressed) {

      if (keyCode == UP) {
        acceleration.y = -0.2;
      }

      if (keyCode == DOWN) {
        acceleration.y = 0.2;
      }

      if (keyCode == LEFT) {
        acceleration.x = -0.2;
      }

      if (keyCode == RIGHT) {
        acceleration.x = 0.2;
      }
    }

    velocity.add(acceleration);
    velocity.limit(topspeed);

    location.add(velocity);

    // Evitar salir de la pantalla
    if (location.x < 24) {
      location.x = 24;
      velocity.x = 0;
    }

    if (location.x > width - 24) {
      location.x = width - 24;
      velocity.x = 0;
    }

    if (location.y < 24) {
      location.y = 24;
      velocity.y = 0;
    }

    if (location.y > height - 24) {
      location.y = height - 24;
      velocity.y = 0;
    }
  }

  void display() {

    stroke(255);
    strokeWeight(2);
    fill(127);

    ellipse(location.x, location.y, 48, 48);
  }
}


// ==========================================
// BOT
// ==========================================

class Bot {

  PVector location;
  float velocidad;

  int contadorFuego;

  Bot() {

    location = new PVector(50, 50);

    velocidad = 2;

    contadorFuego = 0;
  }

  void update(PVector objetivo) {

    // Buscar al jugador
    PVector direccion = PVector.sub(objetivo, location);

    if (direccion.mag() > 0) {
      direccion.normalize();
      direccion.mult(velocidad);

      location.add(direccion);
    }

    // Disparar fuego cada cierto tiempo
    contadorFuego++;

    if (contadorFuego > 60) {

      fuegos.add(new Fuego(location.x, location.y, objetivo));

      contadorFuego = 0;
    }
  }

  void display() {

    fill(255, 0, 0);
    stroke(255);
    strokeWeight(2);

    ellipse(location.x, location.y, 40, 40);
  }

  boolean atrapo(PVector objetivo) {

    float distancia = PVector.dist(location, objetivo);

    return distancia < 20;
  }
}


// ==========================================
// HIELO
// ==========================================

class Hielo {

  PVector location;
  float velocidad;

  Hielo(float x, float y, float direccionX, float direccionY) {

    location = new PVector(x, y);

    PVector direccion = new PVector(direccionX, direccionY);

    direccion.normalize();
    direccion.mult(6);

    velocidad = 6;
  }

  void update() {

    // El hielo se mueve hacia adelante
    // La velocidad se guarda en el vector
    location.x += velocidad;
  }

  void display() {

    fill(150, 220, 255);
    stroke(255);
    strokeWeight(2);

    rectMode(CENTER);
    rect(location.x, location.y, 25, 25);
  }

  boolean chocaCon(PVector otra) {

    float distancia = PVector.dist(location, otra);

    return distancia < 25;
  }
}


// ==========================================
// FUEGO
// ==========================================

class Fuego {

  PVector location;
  PVector velocity;

  Fuego(float x, float y, PVector objetivo) {

    location = new PVector(x, y);

    velocity = PVector.sub(objetivo, location);

    velocity.normalize();
    velocity.mult(5);
  }

  void update() {

    location.add(velocity);
  }

  void display() {

    fill(255, 120, 0);
    stroke(255, 0, 0);
    strokeWeight(2);

    ellipse(location.x, location.y, 15, 15);
  }

  boolean fueraDePantalla() {

    return location.x < 0 ||
           location.x > width ||
           location.y < 0 ||
           location.y > height;
  }
}


// ==========================================
// DISPARAR HIELO
// ==========================================

void keyPressed() {

  if (key == ' ') {

    // Crear hielo desde la posición del jugador
    // Por ahora sale hacia la derecha
    hielos.add(
      new Hielo(
        mover.location.x,
        mover.location.y,
        1,
        0
      )
    );
  }
}
