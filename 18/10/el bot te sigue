// A Mover object
Mover mover;
bot bot;

void setup() {
  size(640,360);
  mover = new Mover(); 
  bot = new bot();
}

void draw() {
  background(0);
  
  // Update the location
  mover.update();
  // Display the Mover
  mover.display(); 
  
  bot.update(mover.location);
  bot.display();
  
  //comprobar si el bot atrapo al circulo
  if (bot.atrapo(mover.location)){
    background(150,0,0);
    
    fill(255);
    textAlign( CENTER, CENTER);
     textSize(30);
     text("¡TE ATRAPÓ!", width/2, height/2);
}
}
class Mover {

  // The Mover tracks location, velocity, and acceleration 
  PVector location;
  PVector velocity;
  PVector acceleration;
  // The Mover's maximum speed
  float topspeed;
  
  Mover() {
    // Start in the center
    location = new PVector(width/2,height/2);
    velocity = new PVector(0,0);
    acceleration = new PVector(0,0);
    topspeed = 5;
  }
  
   void update() {
     acceleration = new PVector(0,0);
   //movimiento con las flechas
   if (keyPressed){
     if (keyCode == UP){
       acceleration.y = -0.2;
     }
     if (keyCode == DOWN){
       acceleration.y = 0.2;
     }
     if (keyCode == LEFT){
       acceleration.x = -0.2;
     }
     if (keyCode == RIGHT){
       acceleration.x = 0.2;
     }
   }
   
   velocity.add(acceleration);
   
    velocity.limit(topspeed);
    
     location.add(velocity);
     
     //Evitar que salga de la pantalla
      
      if (location.x < 24){
        location.x = 24;
        velocity.x = 0;
      }
      
       if (location.x > width - 24){
        location.x = width - 24;
        velocity.x = 0;
       }
       
        if (location.y < 24){
        location.y = 24;
        velocity.y = 0;
       
        }
        
        if (location.y > height - 24){
        location.y = height - 24;
        velocity.y = 0;
       }
   }
        
     void display(){
     stroke (255);
      strokeWeight (2);
      fill (127);
      
      ellipse (location.x, location.y, 48,48);
      
}
}
     class bot{
       PVector location;
       float velocidad;
       
       bot(){

      //el bot empieza en una esquina
         location = new
         PVector(50, 50);
         
         velocidad =2; 
       }
       
       void update(PVector objetivo) {

         //calcualar la direcccion hacia el jugador
         PVector direccion= PVector.sub(objetivo, location);

        //convierte el vector en uno de logitud 1
         direccion.normalize();

         //multiplica por la velocidad del bot
         direccion.mult(velocidad);

        // mueve el bot
         location.add(direccion);
       }
       
       void display(){
         fill(255, 0,0);
         stroke(255);
         strokeWeight(2);
         
         ellipse(location.x, location.y, 40, 40);
       }
       
       boolean atrapo(PVector objetivo) {

//calcular la distancia entre el bot y el jugador
         float distancia = PVector.dist(location, objetivo);

//si estan suficientemente cerca, lo atrapo
         return distancia <40;
       }
     }
     
       
     
     
     
     
     
     
     
     
     
     
     
     
